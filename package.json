{
  "name": "smart-resume-builder",
  "version": "1.0.0",
  "description": "Smart Resume Builder with 5 Formats & Job Matcher",
  "scripts": {
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "node server/server.js",
    "build": "npm run build --prefix client",
    "vercel-build": "npm run build --prefix client",
    "postinstall": "npm install --prefix client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "mongoose": "^8.9.5",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5"
  }
}
